<?xml version="1.0"?>
<package>
  <metadata>
	<title>MC.Code.CLI</title>
    <id>CLIApp</id>
    <version>1.0.0.2</version>
    <authors>Przemysław Załuska</authors>
	<owners>gohunoff@gmail.com</owners>
	<projectUrl>https://github.com/GohunOff/CLIApp</projectUrl>
	<repository type="git" url="https://github.com/GohunOff/CLIApp" />
	  <description>
		  A lightweight and extensible command-line interface (CLI) framework for .NET applications.
		  Define commands, parameters, options, and help messages using simple C# attributes.
		  MC.Code.CLI automatically handles command discovery, argument parsing, default values,
		  command invocation, and help generation.
	  </description>
	  <tags>
		  cli command-line console framework commands arguments options attributes parser
	  </tags>
	 
	  <license type="expression">MIT</license>

	  <readme>README.md</readme>

	  <dependencies>
		  <group targetFramework=".NETFramework4.8" />
	  </dependencies>
	  
  </metadata>
	<files>
		<file src="bin\Release\mcCLIApp.dll" target="lib\net48" />
		<file src="bin\Release\mcCLIApp.xml" target="lib\net48"/>
		<file src="README.md" target="" />
		<file src="LICENSE.txt" target="" />
	</files>
</package>